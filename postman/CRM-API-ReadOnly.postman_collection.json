{
  "info": {
    "name": "VNFITE CRM — API chỉ đọc",
    "description": "Bộ sưu tập kiểm thử API chỉ đọc cho hệ thống CRM VNFITE. Toàn bộ request là GET, trừ các ca âm kiểm phương thức bị từ chối. Không có request tạo, sửa, xoá dữ liệu.\n\nBiến cần khai báo trong môi trường: baseUrl, username, password, customerId. Biến token do request đăng nhập tự ghi lại.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:2345"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "082a18e5-f6a2-475c-b499-6f01fab64bc5"
    },
    {
      "key": "page1Ids",
      "value": ""
    },
    {
      "key": "totalCustomers",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ghi lại thời điểm bắt đầu để tính thời gian cho từng request trong báo cáo.",
          "pm.variables.set('bat_dau', Date.now());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Xác thực và phiên",
      "item": [
        {
          "name": "TC-API-01 Đăng nhập",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã trả về là 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Thời gian phản hồi dưới 3000 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
                  "pm.test(\"Phản hồi là JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Có accessToken\", function () { const j = pm.response.json(); const t = j.accessToken || (j.data && j.data.accessToken); pm.expect(t, \"accessToken\").to.be.a(\"string\"); pm.expect(t.length).to.be.above(20); });",
                  "pm.test(\"Lưu token cho các request sau\", function () { const j = pm.response.json(); const t = j.accessToken || (j.data && j.data.accessToken); if (t) pm.collectionVariables.set(\"token\", t); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Lấy accessToken, lưu vào biến collection `token`. Đây là request duy nhất có thân gửi lên.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "TC-API-02 Đăng nhập sai mật khẩu",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sai mật khẩu không trả 200\", function () { pm.expect(pm.response.code).to.not.equal(200); });",
                  "pm.test(\"Không trả accessToken\", function () { pm.expect(pm.response.text()).to.not.include(\"accessToken\"); });",
                  "pm.test(\"Mã là 400 hoặc 401\", function () { pm.expect([400,401]).to.include(pm.response.code); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Ca âm: mật khẩu sai không được tạo phiên.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"mat-khau-sai-hoan-toan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
